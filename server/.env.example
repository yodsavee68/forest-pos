# Project Settings
PROJECT_NAME="Forest POS"
API_V1_STR="/api/v1"

# Database (Turso / SQLite)
# For Local SQLite: sqlite+aiosqlite:///./forest.db
# For Turso: sqlite+aiosqlite://<username>:<password>@<database-url>
DATABASE_URL="sqlite+aiosqlite:///./forest.db"

# Security
# Run `openssl rand -hex 32` to generate a secure key
SECRET_KEY="change_this_to_a_secure_random_string"

# CORS (Comma separated allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
